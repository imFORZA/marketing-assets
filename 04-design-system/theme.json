{
  "$schema": "https://schemas.imforza.com/m10/theme/1.0.0.json",
  "name": "M10 Marketing Foundation Default Theme",
  "version": "1.0.0",
  "description": "Default design tokens shipped with the Marketing Foundation 10 template pack. Replace values with your brand tokens. Paired with /04-design-system/DESIGN.md and /03-visual/VISUAL-BRAND.md.",
  "meta": {
    "author": "imFORZA",
    "license": "MIT",
    "lastUpdated": "2026-01-01"
  },
  "color": {
    "brand": {
      "primary": {
        "value": "oklch(0.34 0.07 240)",
        "hex": "#0B3A5B",
        "role": "Hero, primary CTA, key nav"
      },
      "primaryHover": {
        "value": "oklch(0.42 0.08 240)",
        "hex": "#124D7A",
        "role": "Hover state for primary"
      },
      "primaryFg": {
        "value": "oklch(1.00 0 0)",
        "hex": "#FFFFFF",
        "role": "Text on primary"
      },
      "secondary": {
        "value": "oklch(0.69 0.17 52)",
        "hex": "#D97706",
        "role": "Supporting elements, secondary CTA"
      },
      "secondaryHover": {
        "value": "oklch(0.60 0.15 50)",
        "hex": "#B45309",
        "role": "Hover state for secondary"
      },
      "secondaryFg": {
        "value": "oklch(1.00 0 0)",
        "hex": "#FFFFFF",
        "role": "Text on secondary"
      }
    },
    "accent": {
      "one": {
        "value": "oklch(0.71 0.17 162)",
        "hex": "#10B981",
        "role": "Highlight, tag, callout"
      },
      "two": {
        "value": "oklch(0.60 0.20 270)",
        "hex": "#6366F1",
        "role": "Chart secondary"
      }
    },
    "neutral": {
      "0": { "value": "oklch(1.00 0 0)", "hex": "#FFFFFF", "role": "Page background" },
      "50": { "value": "oklch(0.98 0.01 240)", "hex": "#F8FAFC", "role": "Card background" },
      "100": { "value": "oklch(0.96 0.01 240)", "hex": "#F1F5F9", "role": "Section background" },
      "200": { "value": "oklch(0.92 0.02 240)", "hex": "#E2E8F0", "role": "Borders, dividers" },
      "300": { "value": "oklch(0.85 0.02 240)", "hex": "#CBD5E1", "role": "Subtle borders" },
      "400": { "value": "oklch(0.72 0.03 240)", "hex": "#94A3B8", "role": "Placeholders" },
      "500": { "value": "oklch(0.55 0.03 240)", "hex": "#64748B", "role": "Secondary text" },
      "700": { "value": "oklch(0.35 0.03 240)", "hex": "#334155", "role": "Body text" },
      "900": { "value": "oklch(0.17 0.03 240)", "hex": "#0F172A", "role": "Headings" }
    },
    "semantic": {
      "success": { "hex": "#10B981", "role": "Success state" },
      "warning": { "hex": "#F59E0B", "role": "Warning state" },
      "danger": { "hex": "#EF4444", "role": "Error state" },
      "info": { "hex": "#3B82F6", "role": "Info state" }
    }
  },
  "typography": {
    "families": {
      "display": {
        "name": "Display",
        "stack": "\"Satoshi\", \"Inter Display\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "weights": [600, 700]
      },
      "body": {
        "name": "Body",
        "stack": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "weights": [400, 500, 600]
      },
      "mono": {
        "name": "Mono",
        "stack": "\"JetBrains Mono\", \"IBM Plex Mono\", Menlo, Consolas, monospace",
        "weights": [400, 500]
      }
    },
    "scale": {
      "displayXl": { "family": "display", "size": 72, "lineHeight": 1.05, "weight": 700, "tracking": "-0.02em" },
      "displayLg": { "family": "display", "size": 56, "lineHeight": 1.1, "weight": 700, "tracking": "-0.02em" },
      "h1":        { "family": "display", "size": 44, "lineHeight": 1.15, "weight": 700, "tracking": "-0.01em" },
      "h2":        { "family": "display", "size": 32, "lineHeight": 1.2, "weight": 600, "tracking": "0" },
      "h3":        { "family": "body", "size": 24, "lineHeight": 1.3, "weight": 600, "tracking": "0" },
      "h4":        { "family": "body", "size": 20, "lineHeight": 1.35, "weight": 600, "tracking": "0" },
      "bodyLg":    { "family": "body", "size": 18, "lineHeight": 1.6, "weight": 400, "tracking": "0" },
      "body":      { "family": "body", "size": 16, "lineHeight": 1.6, "weight": 400, "tracking": "0" },
      "bodySm":    { "family": "body", "size": 14, "lineHeight": 1.55, "weight": 400, "tracking": "0.005em" },
      "mono":      { "family": "mono", "size": 14, "lineHeight": 1.55, "weight": 400, "tracking": "0" }
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 16,
    "xl": 24,
    "pill": 9999
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(15 23 42 / 0.06)",
    "md": "0 4px 8px -2px rgb(15 23 42 / 0.08), 0 2px 4px -2px rgb(15 23 42 / 0.06)",
    "lg": "0 12px 24px -8px rgb(15 23 42 / 0.12), 0 4px 8px -4px rgb(15 23 42 / 0.08)",
    "xl": "0 24px 48px -12px rgb(15 23 42 / 0.18)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "180ms",
      "medium": "240ms",
      "slow": "320ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.4, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    }
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "accessibility": {
    "contrast": {
      "bodyMin": "4.5:1",
      "largeTextMin": "3:1",
      "uiComponentMin": "3:1"
    },
    "focus": {
      "ringWidth": 2,
      "ringOffset": 2,
      "ringColor": "color.brand.primary"
    },
    "tapTargetMin": 44
  }
}
